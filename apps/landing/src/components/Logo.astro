---
interface Props {
  class?: string;
  /** The large file, for the hero. */
  large?: boolean;
}

const { class: className, large = false } = Astro.props;
const src = `${import.meta.env.BASE_URL}${large ? 'oyl-logo-512.png' : 'oyl-logo.png'}`;
---

<img
  src={src}
  width={large ? 512 : 256}
  height={large ? 504 : 252}
  alt=""
  class:list={['brand-mark', className]}
  aria-hidden="true"
  draggable="false"
/>
